// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Example models - customize based on your needs
model Post {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  content          String
  excerpt          String?
  coverImage       String?
  coverImageCredit String?
  author           String   @default("Ken Gooz")
  published        Boolean  @default(false)
  date             DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  categories Category[]
  
  @@map("posts")
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[]
  
  @@map("categories")
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  
  @@map("contacts")
}
