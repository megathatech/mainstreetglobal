# Database - PostgreSQL Neon
# Get your connection string from: https://console.neon.tech
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Unsplash API - For featured images
# Get your keys from: https://unsplash.com/oauth/applications
# 1. Sign up at unsplash.com/developers
# 2. Create a new application
# 3. Copy the Access Key and paste below
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY="your_access_key_here"
UNSPLASH_SECRET_KEY="your_secret_key_here"

# Web3Forms - Contact Form
# Daftar gratis di https://web3forms.com — masukkan email Gmail kamu,
# nanti dapet Access Key lewat email. Paste key-nya di sini.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
